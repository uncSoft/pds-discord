# Copy to .env and fill in. Never commit .env.

# From Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=

# The library's assistant, and the library site the records live on. The defaults are the live ones;
# point them at a staging copy to try changes out.
PDS_CHAT_URL=https://ask.postdrugsyndrome.com
PDS_SITE_ORIGIN=https://postdrugsyndrome.com

# Shared with the assistant (its DISCORD_CLIENT_KEY) so it can hold its rate limit per reader
# instead of per address. Leave blank and the bot still works: all of Discord then shares one
# reader's allowance, which the budgets in pds_discord/limits.py are set to stay inside.
PDS_CLIENT_KEY=

# Where /support and the care-first reply send people.
PDS_SUPPORT_URL=https://postdrugsyndrome.com/research/support

# How many questions to have in flight. The assistant answers two at a time in all, so 1 leaves a
# slot for readers on the library's own site.
PDS_ASK_AT_ONCE=1

# Shown by /about when the bot cannot work out its own invite link.
PDS_INVITE_URL=

# A test server's ID, while you are trying the bot out. Commands registered globally can take an
# hour to reach a client; the same commands registered to one server are there as soon as the bot
# starts. Leave it blank in production.
PDS_GUILD_ID=

LOG_LEVEL=INFO
